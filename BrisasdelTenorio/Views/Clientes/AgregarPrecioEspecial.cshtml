@{
    ViewData["Title"] = "Agregar Precio Especial";
    var cliente = ViewBag.Cliente as BrisasdelTenorio.Models.Cliente;
}

<h2 class="mb-4">💰 Asignar Precio Especial</h2>

<div class="alert alert-info">
    Estás configurando un precio especial para el cliente: <strong>@cliente.Nombre</strong>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="AgregarPrecioEspecial" method="post">
            <input type="hidden" name="clienteId" value="@cliente.ClienteId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Selecciona el Producto</label>
                <select name="productoId" class="form-select" asp-items="ViewBag.Productos" required>
                    <option value="">-- Seleccione un producto --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Precio Especial (₡)</label>
                <input type="number" name="precio" class="form-control" step="0.01" min="0" placeholder="Ej: 950.00" required />
                <small class="text-muted">Este precio reemplazará al precio normal solo para este cliente.</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">💾 Guardar Precio</button>
                <a asp-action="Details" asp-route-id="@cliente.ClienteId" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>