@model BrisasdelTenorio.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<h2 class="text-danger">Eliminar Cliente</h2>
<h4>¿Estás seguro de que deseas desactivar este cliente?</h4>
<p class="text-muted">El cliente se marcará como inactivo pero se conservará en la base de datos para mantener el historial de pedidos.</p>

<hr />
<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>
            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>
        </dl>
    </div>
</div>

<div>
    <!-- Este formulario es el que llama al método POST DeleteConfirmed -->
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ClienteId" />
        <input type="submit" value="Sí, desactivar cliente" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>