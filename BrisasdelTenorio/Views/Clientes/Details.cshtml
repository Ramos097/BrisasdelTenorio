@model BrisasdelTenorio.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
}

<h2>Detalles del Cliente</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Teléfono</dt>
        <dd class="col-sm-9">@Model.Telefono</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Dirección</dt>
        <dd class="col-sm-9">@Model.Direccion</dd>

        <dt class="col-sm-3">Token de Pedido</dt>
        <dd class="col-sm-9"><code>@Model.TokenPedido</code></dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            @if (Model.Activo)
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-danger">Inactivo</span>
            }
        </dd>

        <dt class="col-sm-3">Fecha de Creación</dt>
        <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ClienteId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
<!-- SECCIÓN DE PRECIOS ESPECIALES -->
<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0">💰 Precios Especiales de este Cliente</h5>
        <a asp-action="AgregarPrecioEspecial" asp-route-id="@Model.ClienteId" class="btn btn-sm btn-dark">+ Agregar / Editar Precio</a>
    </div>
    <div class="card-body">
        @{
            // Usamos la lista que ya preparamos en el controlador
            var precios = ViewBag.PreciosEspeciales as List<BrisasdelTenorio.Models.PrecioEspecial>;
        }

        @if (precios != null && precios.Any())
        {
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio Normal</th>
                        <th>Precio Especial</th>
                        <th>Ahorro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pe in precios)
                    {
                        <tr>
                            <td>@pe.Producto.Nombre</td>
                            <td class="text-decoration-line-through text-muted">₡@pe.Producto.Precio.ToString("N0")</td>
                            <td class="text-success fw-bold">₡@pe.Precio.ToString("N0")</td>
                            <td><span class="badge bg-success">-₡@(pe.Producto.Precio - pe.Precio).ToString("N0")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">Este cliente no tiene precios especiales asignados. Paga el precio normal de lista.</p>
        }
    </div>
</div>