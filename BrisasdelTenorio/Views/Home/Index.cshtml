<!-- ESTILOS Y SCRIPTS PARA SCROLL SUAVE -->
<style>
    .hero-section {
        min-height: 80vh;
        display: flex;
        align-items: center;
    }
    .card:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
    }
    
    /* Habilitar scroll suave en toda la página */
    html {
        scroll-behavior: smooth;
    }
    
    /* Compensar la altura del navbar fijo al hacer scroll a una sección */
    section[id] {
        scroll-margin-top: 80px;
    }
</style>

<script>
    // Cerrar el menú hamburguesa en móvil automáticamente al hacer clic en un enlace
    document.querySelectorAll('.navbar-nav .nav-link[href^="#"]').forEach(link => {
        link.addEventListener('click', function() {
            const navbarCollapse = document.querySelector('.navbar-collapse');
            if (navbarCollapse && navbarCollapse.classList.contains('show')) {
                const bsCollapse = new bootstrap.Collapse(navbarCollapse, { toggle: true });
                bsCollapse.hide();
            }
        });
    });
</script>